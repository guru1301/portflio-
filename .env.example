# ====================================================================
# PORTFOLIO INQUIRIES & DATABASE CONFIGURATION
# ====================================================================
# By default, inquiries are automatically backed up to browser localStorage 
# so the form and success tick screen work 100% immediately without any setup.
#
# Choose your preferred cloud storage option below:

# --------------------------------------------------------------------
# OPTION 1: SUPABASE (Recommended for full SQL Database & Table storage)
# --------------------------------------------------------------------
# 1. Sign up for free at https://supabase.com
# 2. Create a new project (e.g. "portfolio-db")
# 3. In the SQL Editor, run:
#
#    create table contact_submissions (
#      id uuid default gen_random_uuid() primary key,
#      name text not null,
#      email text not null,
#      phone text default '',
#      message text not null,
#      service_type text default 'General Project',
#      created_at timestamp with time zone default timezone('utc'::text, now()) not null
#    );
#
#    alter table contact_submissions enable row level security;
#    create policy "Allow anonymous inserts" on contact_submissions for insert with check (true);
#
# 4. Copy your Project URL & Anon Key from Settings -> API and paste here:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --------------------------------------------------------------------
# OPTION 2: WEB3FORMS (Recommended for Instant Email & Phone Alert)
# --------------------------------------------------------------------
# If you prefer getting an instant email to your Gmail whenever someone submits:
# 1. Go to https://web3forms.com
# 2. Enter your email to get a free Access Key
# 3. Paste your Access Key below:
# VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
